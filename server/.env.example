# Copy this file to .env and fill in the values. Never commit .env.

# development | production | test
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. Put the database name before the "?", for example:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scanserve?retryWrites=true&w=majority
MONGODB_URI=

# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Frontend address allowed by CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Time zone for the daily order numbers
TZ_BUSINESS=Asia/Kolkata
